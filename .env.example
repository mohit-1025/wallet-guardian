# Wallet Guardian — environment (server-side only)
# Copy to .env. Secrets are read by server/index.mjs and never sent to the browser.
#
# Real accounts sign in with PayPal and use live money only. The demo workspace is
# the only sandbox path: it uses the sandbox app when configured, otherwise it
# records clearly-labelled simulations. There is no sandbox fallback for a real
# PayPal session.

PORT=8787

# Live REST app (https://developer.paypal.com/dashboard/applications/live)
# Required for "Continue with PayPal". Enable "Log in with PayPal" and register:
#   http://localhost:8787/api/auth/paypal/callback
# You can leave both blank and connect the app once at http://localhost:5173/setup
# instead. The server verifies the credentials, encrypts them, and stores them in
# a local SQLite settings database (WG_DATA_DIR, default ~/.wallet-guardian).
PAYPAL_LIVE_CLIENT_ID=
PAYPAL_LIVE_CLIENT_SECRET=
# auto | false — set false if Payouts is not enabled on the live account
PAYPAL_LIVE_PAYOUTS_ENABLED=auto
PAYPAL_INVOICER_EMAIL=

# Sandbox REST app (https://developer.paypal.com/dashboard/applications/sandbox)
# Optional. Used only by the demo workspace; blank means labelled simulation.
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
PAYPAL_SANDBOX_PAYOUTS_ENABLED=auto
PAYPAL_SANDBOX_INVOICER_EMAIL=

# Business-account features: payouts, invoices and reporting. Comma-separated
# PayPal emails allowed to use them. These act on the business account that owns
# the app credentials, never on a signed-in payer's personal account.
# Reporting also requires "Transaction Search" to be enabled for the app.
# Leave blank to disable business payouts, invoices and reporting.
PAYPAL_BUSINESS_EMAILS=

# Sign-in cookie signing secret. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Public URL of this API (PayPal redirect + cookie scope). Set the https URL in production.
PUBLIC_BASE_URL=http://localhost:8787
# Where users land after sign-in (Vite dev server or your hosted app).
APP_BASE_URL=http://localhost:5173

# Directory for the encrypted settings database. Defaults to ~/.wallet-guardian.
WG_DATA_DIR=
# 32-byte key (64 hex chars or base64) for that database. Generated into
# settings.key on first run when blank. Treat it like the PayPal secret itself.
WG_SETTINGS_KEY=

# INR → USD rate used when charging PayPal (PayPal charges in USD here).
USD_INR_RATE=83.2

# Reserved for a hosted Supabase deployment (schema in supabase/schema.sql)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
