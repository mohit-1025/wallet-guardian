# Wallet Guardian — environment (server-side only)
# Copy to .env. Secrets are read by server/index.mjs and never sent to the browser.
#
# Accounts sign in with email + password. Every payment — demo or email account —
# runs against the PayPal sandbox. When no sandbox credentials are set, money
# routes return clearly-labelled simulations instead. There is no live API path.

PORT=8787

# PayPal sandbox REST app (https://developer.paypal.com/dashboard/applications/sandbox)
# Optional. Users can also connect a sandbox app during onboarding: the server
# verifies it with PayPal, encrypts it (AES-256-GCM) into settings.db and never
# sends it back to the browser. Credentials set here take precedence and make
# the onboarding connect form read-only.
# Reporting also requires "Transaction Search" enabled for the app.
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
# auto | false — set false if Payouts is not enabled on the sandbox account
PAYPAL_SANDBOX_PAYOUTS_ENABLED=auto
# Sandbox business account that sends invoices and payouts
PAYPAL_SANDBOX_INVOICER_EMAIL=

# Sign-in cookie signing secret. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Public URL of this API (cookie scope). Set the https URL in production.
PUBLIC_BASE_URL=http://localhost:8787
# When Vercel proxies /api/* to this server, PUBLIC_BASE_URL is the Vercel origin
# (https://walletguardian.vercel.app) and TRUST_PROXY counts the proxy hops (2).
TRUST_PROXY=0
# Where users land after sign-in (Vite dev server or your hosted app).
APP_BASE_URL=http://localhost:5173

# Directory for the accounts database (accounts.db). Defaults to ~/.wallet-guardian.
WG_DATA_DIR=
# 32-byte key (64 hex chars) that encrypts sandbox credentials connected at
# onboarding (stored in <WG_DATA_DIR>/settings.db). If unset, the server creates
# <WG_DATA_DIR>/settings.key once; set this explicitly on hosted deploys so the
# key survives redeploys.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WG_SETTINGS_KEY=

# INR → USD rate used when charging PayPal (PayPal charges in USD here).
USD_INR_RATE=83.2

# Reserved for a hosted Supabase deployment (schema in supabase/schema.sql)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
